{
	"name": "EmbedService",
	"version": "4.1.2",
	"author": [
		"[https://www.mediawiki.org/wiki/User:Octfx Octfx]",
		"[https://www.mediawiki.org/wiki/User:Alistair3149 Alistair3149]",
		"Jim R. Wilson",
		"Andrew Whitworth",
		"Alexia E. Smith",
		"Cameron M. Chunn"
	],
	"url": "https://github.com/StarCitizenWiki/mediawiki-extensions-EmbedService",
	"descriptionmsg": "embedservice-description",
	"license-name": "MIT",
	"type": "parserhook",
	"requires": {
		"MediaWiki": ">= 1.43.0",
		"platform": {
			"php": ">=8.1"
		}
	},
	"MessagesDirs": {
		"EmbedService": [
			"i18n"
		]
	},
	"ExtensionMessagesFiles": {
		"EmbedServiceMagic": "EmbedService.i18n.magic.php",
		"EmbedServiceAliases": "EmbedService.alias.php"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\EmbedService\\": "includes/"
	},
	"APIModules": {
		"embedservice": "MediaWiki\\Extension\\EmbedService\\ApiEmbedService"
	},
	"ResourceModules": {
		"ext.embedService.messages": {
			"messages": [
				"embedservice-description",
				"embedservice-load",
				"embedservice-play",
				"embedservice-type-audio",
				"embedservice-type-content",
				"embedservice-type-video",
				"embedservice-consent-privacy-policy",
				"embedservice-consent-privacy-notice-text",
				"embedservice-consent-privacy-notice-continue",
				"embedservice-consent-privacy-notice-dismiss",
				"embedservice-service-alugha",
				"embedservice-service-amazonmusic",
				"embedservice-service-aparat",
				"embedservice-service-applemusic",
				"embedservice-service-archiveorg",
				"embedservice-service-bandcamp",
				"embedservice-service-bilibili",
				"embedservice-service-ccc",
				"embedservice-service-dailymotion",
				"embedservice-service-deezer",
				"embedservice-service-loom",
				"embedservice-service-navertv",
				"embedservice-service-niconico",
				"embedservice-service-podbean",
				"embedservice-service-qobuz",
				"embedservice-service-reddit",
				"embedservice-service-sharepoint",
				"embedservice-service-soundcloud",
				"embedservice-service-spotify",
				"embedservice-service-substack",
				"embedservice-service-takhtesefid",
				"embedservice-service-tidal",
				"embedservice-service-twitch",
				"embedservice-service-videolink",
				"embedservice-service-vimeo",
				"embedservice-service-vk",
				"embedservice-service-wistia",
				"embedservice-service-youku",
				"embedservice-service-youtube",
				"embedservice-service-localvideo",
				"embedservice-service-externalvideo"
			]
		},
		"ext.embedService.videolink": {
			"packageFiles": [
				"ext.embedService.videolink.js",
				"fetchers/fetchFactory.js",
				"fetchers/queryKeyParser.js",
				"fetchers/bilibili.js",
				"fetchers/niconico.js",
				"fetchers/oembed.js",
				"modules/iframe.js"
			],
			"styles": [
				"ext.embedService.consent.less",
				"ext.embedService.evl.less"
			],
			"dependencies": [
				"mediawiki.storage"
			]
		},
		"ext.embedService.consent": {
			"packageFiles": [
				"ext.embedService.consent.js",
				"fetchers/fetchFactory.js",
				"fetchers/queryKeyParser.js",
				"fetchers/bilibili.js",
				"fetchers/niconico.js",
				"fetchers/oembed.js",
				"modules/iframe.js"
			],
			"styles": [
				"ext.embedService.consent.less"
			],
			"dependencies": [
				"mediawiki.storage"
			]
		},
		"ext.embedService.overlay": {
			"scripts": [
				"ext.embedService.overlay.js"
			],
			"styles": [
				"ext.embedService.consent.less"
			],
			"messages": [
				"embedservice-play"
			]
		},
		"ext.embedService.styles": {
			"styles": [
				"ext.embedService.styles.less"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "resources",
		"remoteExtPath": "EmbedService/resources"
	},
	"config": {
		"EmbedServiceAddFileExtensions": {
			"description": "Adds 'flac', 'mkv', 'mov', 'mp3', 'mp4', 'oga', 'ogg', 'ogv', 'wav', 'webm' to $wgFileExtensions.",
			"value": true
		},
		"EmbedServiceEnableVideoHandler": {
			"description": "Enables the video handler which displays local videos using the html5 <video> tag.",
			"value": true
		},
		"EmbedServiceLazyLoadLocalVideos": {
			"description": "Sets 'preload=none' on every <video> tag.",
			"value": false
		},
		"EmbedServiceUseEmbedStyleForLocalVideos": {
			"description": "Styles local videos like they are embedded",
			"value": true
		},
		"EmbedServiceEnableAudioHandler": {
			"description": "Enables the audio handler which displays local videos using the html5 <audio> tag.",
			"value": true
		},
		"EmbedServiceMinWidth": {
			"description": "Minimum width of the embedded iframe.",
			"value": null
		},
		"EmbedServiceMaxWidth": {
			"description": "Maximum width of the embedded iframe.",
			"value": null
		},
		"EmbedServiceDefaultWidth": {
			"description": "Default fallback width",
			"value": 640
		},
		"FFProbeLocation": {
			"description": "Location to ffprobe",
			"value": "/usr/bin/ffprobe"
		},
		"EmbedServiceEnabledServices": {
			"description": "List of services to enable, if empty, enable all",
			"value": []
		},
		"EmbedServiceRequireConsent": {
			"description": "Explicitly require consent by only loading the iframe after the user clicks play",
			"value": true
		},
		"EmbedServiceFetchExternalThumbnails": {
			"description": "Fetch video thumbnails by querying the respective external oembed endpoints. This results in a http call.",
			"value": true
		},
		"EmbedServiceShowPrivacyNotice": {
			"description": "Require the user to acknowledge that the external service may collect user data, after giving consent",
			"value": true
		}
	},
	"ConfigRegistry": {
		"EmbedService": "MediaWiki\\Config\\GlobalVarConfig::newInstance"
	},
	"AvailableRights": [
		"embedservice-refreshmetadata"
	],
	"GroupPermissions": {
		"sysop": {
			"embedservice-refreshmetadata": true
		}
	},
	"ExtensionFunctions": [
		"MediaWiki\\Extension\\EmbedService\\EmbedServiceHooks::setup"
	],
	"HookHandlers": {
		"EmbedServiceHooks": {
			"class": "MediaWiki\\Extension\\EmbedService\\EmbedServiceHooks",
			"services": [
				"ConfigFactory",
				"RepoGroup"
			]
		}
	},
	"Hooks": {
		"ParserFirstCallInit": "EmbedServiceHooks",
		"BeforePageDisplay": "EmbedServiceHooks",
		"SkinTemplateNavigation::Universal": "EmbedServiceHooks"
	},
	"SpecialPages": {
		"RefreshEmbedServiceMetadata": {
			"class": "MediaWiki\\Extension\\EmbedService\\Specials\\SpecialRefreshEmbedServiceMetadata",
			"services": [
				"RepoGroup",
				"TitleFactory"
			]
		}
	},
	"manifest_version": 2
}
